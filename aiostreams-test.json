    "id": "prism",
    "definitions": {
      "custom": {
        "name": "",
        "description": ""
      },
      "overrides": {
        "prism": {
          "name": "{stream.resolution::exists[\"{stream.resolution::replace('2160p','4K')::replace('1440p','2K')}\"||\"Unknown\"]}{service.cached::istrue[\" ⚡️\"||\"\"]}{stream.upscaled::istrue[\" 🤮\"||\"\"]}\n{stream.quality::exists[\"{stream.quality::replace('BluRay REMUX','REMUX')::replace('Bluray REMUX','REMUX')}\"||\"\"]}{stream.visualTags::~DV[\" • Dolby Vision\"||\"\"]}{stream.visualTags::~HDR[\" • HDR\"||\"\"]}{stream.visualTags::~HDR10[\" • HDR10\"||\"\"]}{stream.visualTags::~HDR10+[\" • HDR10+\"||\"\"]}\n{stream.encode::exists[\"{stream.encode}\"||\"\"]}\n{stream.nSeScore::>=80[\"★★★★★\"||\"\"]}{stream.nSeScore::>=60::and::stream.nSeScore::<80[\"★★★★\"||\"\"]}{stream.nSeScore::>=40::and::stream.nSeScore::<60[\"★★★\"||\"\"]}{stream.nSeScore::>=20::and::stream.nSeScore::<40[\"★★\"||\"\"]}{stream.nSeScore::<20[\"★\"||\"\"]}",
          "description": "{stream.seasonPack::istrue[\"[❖]\"||\"[◈]\"]} {stream.season::exists[\"S{stream.season}\"||\"\"]}{stream.episode::exists[\"E{stream.episode} · \"||\"\"]}{stream.title}{stream.editions::exists[\" · {stream.editions::join(' · ')}\"||\"\"]}\n\n{stream.audioTags::exists[\"[∿] {stream.audioTags::join(' ')::replace('DTS-HD MA','⭐ DTS-HD MA')::replace('DTS-X','⭐ DTS-X')::replace('Atmos','⭐ Atmos')::replace('TrueHD','⭐ TrueHD')::replace('FLAC','⭐ FLAC')}\"||\"\"]}\n\n{stream.size::>0[\"[⛁] {stream.size::sbytes}\"||\"\"]}{stream.bitrate::>0[\" · {stream.bitrate::sbitrate}\"||\"\"]}{stream.seeders::>0[\" 🌱 {stream.seeders}\"||\"\"]}\n\n[@] {stream.indexer::exists[\"{stream.indexer} · \"||\"\"]}{addon.name}\n\n{stream.languages::exists[\"🌐 {stream.languages::join(' · ')}\"||\"\"]}\n\n{stream.subtitles::exists[\"📙 {stream.subtitles::join(' · ')}\"||\"\"]}"
        }
      }
    }
